{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "http://localhost:5000",
      "http://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "drugs-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/drugs/{**catch-all}"
        }
      },
      "suppliers-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/suppliers/{**catch-all}"
        }
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        }
      },
      "orders-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "payments-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "salereports-route": {
        "ClusterId": "salereport-cluster",
        "Match": {
          "Path": "/api/salereports/{**catch-all}"
        }
      },
      "swagger-auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/docs/auth/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**remainder}" }
        ]
      },
      "swagger-inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/docs/inventory/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**remainder}" }
        ]
      },
      "swagger-order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/docs/orders/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**remainder}" }
        ]
      },
      "swagger-payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/docs/payments/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**remainder}" }
        ]
      },
      "swagger-salereport-route": {
        "ClusterId": "salereport-cluster",
        "Match": {
          "Path": "/docs/salereports/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**remainder}" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "salereport-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5005"
          }
        }
      }
    }
  }
}
